<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DWB · MCP Servers" Width="1160" Height="800" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
 Background="#08121F" Foreground="#EDF4FF" FontFamily="Leelawadee UI, Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#52E3F0"/>
  <SolidColorBrush x:Key="TextBrush" Color="#EDF4FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#91A8BF"/>
  <SolidColorBrush x:Key="LineBrush" Color="#263B50"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#101D2C"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#182A3C"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#34516A"/>
   <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform x:Name="Scale"/></Border.RenderTransform>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.14"/>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.14"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0B1724"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#2C4359"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DAE7F2"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowBackground" Value="#101D2C"/><Setter Property="AlternatingRowBackground" Value="#132235"/><Setter Property="AlternationCount" Value="2"/>
   <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="RowHeight" Value="50"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#17283A"/><Setter Property="Foreground" Value="#9DB8CE"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Error}"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#E2EDF7"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3044"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C3C50"/><Setter Property="Foreground" Value="White"/></Trigger>
  </Style.Triggers></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="Background" Value="#101D2C"/><Setter Property="Padding" Value="10,8"/>
   <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#1B3549"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5261"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="PackageSelectorStyle" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="Background" Value="#0B1724"/><Setter Property="BorderBrush" Value="#34516A"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="42"/><Setter Property="MaxDropDownHeight" Value="280"/>
   <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Type ComboBoxItem}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid SnapsToDevicePixels="True">
     <Border x:Name="PackageSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
      <Grid>
       <ContentPresenter x:Name="SelectionSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,42,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Right" Width="38" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
         <Border Background="Transparent" CornerRadius="0,8,8,0"><Grid><Ellipse Width="22" Height="22" Fill="#14263A"/><Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0" Stroke="#AFC1D2" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path></Grid></Border>
         <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="#52E3F0"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></ToggleButton.Template>
       </ToggleButton>
      </Grid>
     </Border>
     <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
      <Border Background="#101D2C" BorderBrush="#344D68" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <Border.Effect><DropShadowEffect Color="#050B12" BlurRadius="22" ShadowDepth="6" Opacity="0.65"/></Border.Effect>
       <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PackageSurface" Property="BorderBrush" Value="#52E3F0"/><Setter TargetName="PackageSurface" Property="Background" Value="#0E1B2B"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PackageSurface" Property="BorderBrush" Value="#52E3F0"/></Trigger>
     <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="PackageSurface" Property="BorderBrush" Value="#52E3F0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PackageSurface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="MCP SERVER MANAGER  ·  DWB" Foreground="#56DDEB" FontSize="10" FontWeight="Bold"/>
    <TextBlock Text="จัดการ MCP Servers" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
    <TextBlock Text="ติดตั้งจาก catalog หรือเพิ่ม server เอง · เปิดใช้เฉพาะตัวที่คุณเลือก" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
   </StackPanel>
   <Button x:Name="Refresh" Grid.Column="1" Content="⟳  รีเฟรชรายการ" VerticalAlignment="Center" Padding="16,11"/>
  </Grid>

  <Border x:Name="CatalogPanel" Grid.Row="1" BorderBrush="#28445B" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,15">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#152A3A" Offset="0"/><GradientStop Color="#111B31" Offset="0.56"/><GradientStop Color="#19243B" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect x:Name="CatalogGlow" Color="#27BFD6" BlurRadius="25" ShadowDepth="0" Opacity="0.30"/></Border.Effect>
   <Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
    <DoubleAnimation Storyboard.TargetName="CatalogGlow" Storyboard.TargetProperty="Opacity" From="0.22" To="0.48" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"/>
   </Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
     <TextBlock Text="ติดตั้งได้เร็ว" Foreground="#8C81FF" FontWeight="Bold" FontSize="11"/>
     <TextBlock Text="ติดตั้งจาก Catalog" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
     <TextBlock Text="เลือกแพ็กเกจที่ตรวจสอบแล้ว" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
     <TextBlock Text="SERVER PACKAGE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,6"/>
     <ComboBox x:Name="Catalog" DisplayMemberPath="name" Style="{StaticResource PackageSelectorStyle}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
     <TextBlock Text="โฟลเดอร์ที่อนุญาต (Filesystem)" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,6"/>
     <TextBox x:Name="AllowedDirectory" ToolTip="เลือกโฟลเดอร์ที่ MCP server มีสิทธิ์เข้าถึง"/>
    </StackPanel>
    <Button x:Name="ChooseDirectory" Grid.Column="3" Content="เลือกโฟลเดอร์" Margin="0,21,8,0" VerticalAlignment="Top"/>
    <Button x:Name="InstallCatalog" Grid.Column="4" Content="ติดตั้ง server  →" Background="#55DDEA" Foreground="#081923" BorderBrush="#55DDEA" FontWeight="Bold" Margin="0,21,0,0" VerticalAlignment="Top"/>
    <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#0D1928" BorderBrush="#25384C" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,13,0,0">
     <TextBlock x:Name="CatalogInfo" Foreground="#AFC1D2" FontSize="11" Text="เลือก package เพื่อดูรายละเอียดและขอบเขตสิทธิ์ก่อนติดตั้ง"/>
    </Border>
    <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="0,13,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="หรือวาง GitHub repository ของ MCP Server" Foreground="#DDEAF7" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBox x:Name="GitHubRepository" ToolTip="เช่น https://github.com/valrinx/raven-roblox-mcp"/>
      <TextBlock Text="รองรับ Node MCP ที่มีคำสั่งรันใน package.json · ติดตั้งในโฟลเดอร์ DWB" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
     </StackPanel>
     <Button x:Name="InstallGitHub" Grid.Column="1" Content="ติดตั้งจาก GitHub  →" Background="#8177FF" Foreground="White" BorderBrush="#A69FFF" Margin="12,20,0,0" VerticalAlignment="Top"/>
     <Border x:Name="GitHubStatusPanel" Grid.Row="1" Grid.ColumnSpan="2" Background="#0D1928" BorderBrush="#34446F" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,9,0,0">
      <StackPanel>
       <TextBlock x:Name="GitHubStatus" Text="Paste a GitHub repository URL and choose Install from GitHub. Installed servers stay disabled until enabled." Foreground="#AFC1D2" FontSize="11"/>
       <ProgressBar x:Name="GitHubProgress" Height="3" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed" Background="#1A2A3D" Foreground="#8177FF" BorderThickness="0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>

  <Grid x:Name="SummaryCards" Grid.Row="2" Margin="0,0,0,15">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#111F2E" BorderBrush="#263B50" BorderThickness="1" CornerRadius="11" Padding="15,12" Margin="0,0,9,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="4" Height="37" Background="#57DDED" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="SERVERS" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ServerCount" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid>
   </Border>
   <Border Grid.Column="1" Background="#111F2E" BorderBrush="#263B50" BorderThickness="1" CornerRadius="11" Padding="15,12" Margin="3,0,6,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="4" Height="37" Background="#63D7B4" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="เปิดใช้งาน" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="EnabledCount" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid>
   </Border>
   <Border Grid.Column="2" Background="#111F2E" BorderBrush="#263B50" BorderThickness="1" CornerRadius="11" Padding="15,12" Margin="6,0,3,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="4" Height="37" Background="#7D9CFF" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="กำลังทำงาน" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="RunningCount" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid>
   </Border>
   <Border Grid.Column="3" Background="#111F2E" BorderBrush="#263B50" BorderThickness="1" CornerRadius="11" Padding="15,12" Margin="9,0,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="4" Height="37" Background="#FF9AAB" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="ต้องตรวจสอบ" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ProblemCount" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid>
   </Border>
  </Grid>

  <Border x:Name="ServersPanel" Grid.Row="3" Background="#0D1927" BorderBrush="#22374B" BorderThickness="1" CornerRadius="13" Padding="14" Height="280" Margin="0,0,0,15">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="MCP Servers ของคุณ" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="เลือกแถวเพื่อดูหรือแก้การตั้งค่า · server ที่ติดตั้งใหม่จะปิดไว้ก่อน" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
     <Button x:Name="NewServer" Grid.Column="1" Content="＋  เพิ่ม server เอง" Margin="0,0,10,0"/>
     <Border x:Name="BrokerStatusIndicator" Grid.Column="2" Width="28" Height="28" Background="#111F2E" BorderBrush="#2A4156" BorderThickness="1" CornerRadius="14" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="รอ MCP เชื่อมต่อ">
      <Grid><Ellipse x:Name="BrokerDot" Width="8" Height="8" Fill="#91A8BF" ToolTip="รอ MCP เชื่อมต่อ" AutomationProperties.Name="รอ MCP เชื่อมต่อ"/></Grid>
     </Border>
    </Grid>
    <Grid Grid.Row="1">
     <DataGrid x:Name="Servers" SelectionMode="Single"><DataGrid.Columns>
      <DataGridTextColumn Header="ชื่อ server" Binding="{Binding Name}" Width="145"/>
      <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="125"/>
      <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2*" MinWidth="150"/>
      <DataGridTemplateColumn Header="สถานะ" Width="185"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Border Padding="9,4" CornerRadius="12" BorderThickness="1" HorizontalAlignment="Left">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#193441"/><Setter Property="BorderBrush" Value="#2E6570"/><Style.Triggers>
         <DataTrigger Binding="{Binding StateKey}" Value="disabled"><Setter Property="Background" Value="#242F3E"/><Setter Property="BorderBrush" Value="#48566A"/></DataTrigger>
         <DataTrigger Binding="{Binding StateKey}" Value="error"><Setter Property="Background" Value="#3B2332"/><Setter Property="BorderBrush" Value="#84445D"/></DataTrigger>
         <DataTrigger Binding="{Binding StateKey}" Value="running"><Setter Property="Background" Value="#183B3B"/><Setter Property="BorderBrush" Value="#367D71"/></DataTrigger>
         <DataTrigger Binding="{Binding StateKey}" Value="ready"><Setter Property="Background" Value="#202A46"/><Setter Property="BorderBrush" Value="#4D5D98"/></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"/>
       </Border>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Sessions" Binding="{Binding Sessions}" Width="80"/>
      <DataGridTextColumn Header="รายละเอียด" Binding="{Binding Error}" Width="2*" MinWidth="130"/>
     </DataGrid.Columns></DataGrid>
     <Border x:Name="EmptyState" Background="#0E1B29" BorderBrush="#2B4359" BorderThickness="1" CornerRadius="11" Margin="10" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
       <TextBlock Text="◌" Foreground="#61DCEB" FontSize="36" HorizontalAlignment="Center"/>
       <TextBlock Text="ยังไม่มี MCP Server" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
       <TextBlock Text="เลือก server จาก Catalog ด้านบนเพื่อติดตั้ง หรือกด ‘เพิ่ม server เอง’ สำหรับโปรแกรมที่มีอยู่แล้ว" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>

  <Expander x:Name="Editor" Grid.Row="4" IsExpanded="False" Background="#101D2C" BorderBrush="#263B50" BorderThickness="1" Padding="13" Margin="0,0,0,12">
   <Expander.Header><StackPanel><TextBlock x:Name="EditorTitle" Text="การตั้งค่า server" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="เลือกแถวเพื่อแก้ไข หรือเพิ่ม server เอง · รายละเอียดขั้นสูงพับเก็บได้" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Expander.Header>
   <Grid Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="SaveServer" Content="บันทึกการตั้งค่า" Background="#55DDEA" Foreground="#081923" BorderBrush="#55DDEA"/>
     <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <CheckBox x:Name="Enabled" Content="เปิดใช้งาน server นี้" Foreground="#C7D8E7" VerticalAlignment="Center" ToolTip="เมื่อปิด server จะไม่ถูกรวม tools เข้า MCP"/>
      <Button x:Name="RemoveServer" Content="ลบ server" Margin="14,0,0,0" Background="#382331" BorderBrush="#694053"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock Text="Server ID · ต้องไม่ซ้ำ" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="Id" ToolTip="รหัสสั้น ๆ สำหรับอ้างอิง server นี้"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="5,0,10,0"><TextBlock Text="ชื่อที่แสดง" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="Name"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Command / executable" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="Command" ToolTip="เช่น node.exe หรือ path ไปยังโปรแกรม server"/></StackPanel>
    </Grid>
    <Expander x:Name="AdvancedSettings" Grid.Row="2" IsExpanded="False" Background="#0D1825" BorderBrush="#22374B" BorderThickness="1" Padding="10">
     <Expander.Header><TextBlock Text="ตั้งค่าขั้นสูง · Arguments, โฟลเดอร์ทำงาน และ Environment" Foreground="#AFC2D2" FontSize="11"/></Expander.Header>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="Working directory · ไม่บังคับ" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="Cwd" ToolTip="โฟลเดอร์ที่ใช้เป็นจุดเริ่มของ server"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="5,0,10,0"><TextBlock Text="Arguments · หนึ่งรายการต่อบรรทัด" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="Args" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" MinHeight="90"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Environment · KEY=VALUE ต่อบรรทัด" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="Environment" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" MinHeight="90"/><TextBlock Text="ค่าที่บันทึกจะแสดงเป็น KEY= เพื่อปิดบัง secret · เว้นว่างเพื่อคงค่าเดิม · ใช้ KEY=!clear เพื่อลบ" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
     </Grid>
    </Expander>
   </Grid>
  </Expander>

  <Border x:Name="FooterPanel" Grid.Row="5" Background="#0D1927" BorderBrush="#263B50" BorderThickness="1" CornerRadius="10" Padding="12,9">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="✦" Foreground="#FFC96F" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <StackPanel Grid.Column="1"><TextBlock x:Name="ActionStatus" Text="กำลังอ่านรายการ server…" Foreground="#C8D7E5" FontSize="11"/><TextBlock Text="MCP server ภายนอกทำงานด้วยสิทธิ์ของ Windows account นี้ · ข้อมูล Environment เข้ารหัสด้วย DPAPI บนเครื่อง" Foreground="#8197AB" FontSize="10" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
 </ScrollViewer>
</Window>
