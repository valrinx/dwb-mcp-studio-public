<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="N3zuui · Core Dashboard" Width="1240" Height="850" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen"
 Foreground="#EAFBFF" FontFamily="Leelawadee UI, Segoe UI" FontSize="13">
 <Window.Background><RadialGradientBrush Center="0.78,1" GradientOrigin="0.78,1" RadiusX="1.15" RadiusY="1.05"><GradientStop Color="#171A20" Offset="0"/><GradientStop Color="#0D0F13" Offset="0.48"/><GradientStop Color="#08090C" Offset="1"/></RadialGradientBrush></Window.Background>
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Margin" Value="12,0,4,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#111419"/><Setter Property="Foreground" Value="#EAFBFF"/><Setter Property="BorderBrush" Value="#2A3038"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A9F5FF"/><Setter TargetName="Surface" Property="Background" Value="#171A20"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#0D0F13"/><Setter Property="Foreground" Value="#D7E3E8"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowBackground" Value="#0D0F13"/><Setter Property="AlternatingRowBackground" Value="#111419"/>
   <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="RowHeight" Value="38"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserReorderColumns" Value="False"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#171A20"/><Setter Property="Foreground" Value="#929DA8"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#0B0D11" BorderBrush="#20252C" BorderThickness="0,0,1,0" Padding="24,28">
   <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="N3ZUUI  /  WINDOWS CORE" Foreground="#66717C" FontSize="10"/><TextBlock x:Name="Version" Foreground="#8B959F" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="เลือกการเปิด / ปิดแอปได้&#10;ในเมนูด้านบนหรือ tray" Foreground="#8B959F" FontSize="12" Margin="0,18,0,0"/></StackPanel>
    <StackPanel>
     <Border x:Name="LogoFrame" Width="128" Height="128" HorizontalAlignment="Left" Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="20" Padding="5">
      <Border.Effect><DropShadowEffect Color="#A9F5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.12"/></Border.Effect>
      <Image x:Name="Logo" Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
      <TextBlock x:Name="BrandTitle" Text="N3zuui Studio" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="CORE DASHBOARD" Foreground="#A9F5FF" FontSize="10" FontWeight="Bold" Margin="0,6,0,26"/>
      <Border Background="#111419" CornerRadius="9" Padding="14,12" BorderBrush="#A9F5FF" BorderThickness="1"><TextBlock Text="ภาพรวมระบบ" Foreground="#D9FBFF"/></Border>
     <Button x:Name="Connection" Content="ตั้งค่า Tunnel / API key" Margin="0,14,0,0" Padding="8,12" Height="42"/>
     <Button x:Name="MachineSetup" Content="ตั้งค่าเครื่อง" Margin="0,10,0,0" Height="42"/>
     <Button x:Name="McpServers" Content="MCP Servers" Margin="0,10,0,0" Height="42"/>
     <Button x:Name="AppPreferences" Content="การเปิดและปิดแอป" Margin="0,10,0,0" Height="42"/>
     <Button x:Name="WorkspaceHelp" Content="วิธีใช้ Workspace" Margin="0,10,0,0" Height="42"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="175"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ภาพรวมการทำงาน" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="Updated" Text="กำลังอ่านสถานะ…" Foreground="#8A949E" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Refresh" Content="รีเฟรช"/><Button x:Name="StopMcp" Content="Stop" Margin="9,0,0,0"/><Button x:Name="StartMcp" Content="Start MCP →" Background="#A9F5FF" Foreground="#071014" BorderBrush="#A9F5FF" FontWeight="Bold" Margin="9,0,0,0"/></StackPanel>
   </Grid>
   <UniformGrid x:Name="StatsCards" Grid.Row="1" Columns="4" Margin="0,0,0,20">
     <Border Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="11" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="TUNNEL" FontSize="10" Foreground="#737E89"/><TextBlock x:Name="TunnelStatus" Text="—" FontSize="22" Margin="0,7,0,0"/><TextBlock x:Name="TunnelDetail" Text="การเชื่อมต่อ OpenAI" Foreground="#737E89" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
     <Border Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="11" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="BROKER" FontSize="10" Foreground="#737E89"/><TextBlock x:Name="BrokerStatus" Text="—" FontSize="22" Margin="0,7,0,0"/><TextBlock x:Name="BrokerDetail" Text="ตัวจัดการ worker" Foreground="#737E89" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
     <Border Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="11" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="WORKERS" FontSize="10" Foreground="#737E89"/><TextBlock x:Name="Workers" Text="—" FontSize="28" Margin="0,3,0,0"/><TextBlock x:Name="WorkerDetail" Text="จำนวนที่เปิด / สูงสุด" Foreground="#737E89" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
     <Border Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="11" Padding="17,15"><StackPanel><TextBlock Text="งานรอในคิว" FontSize="10" Foreground="#737E89"/><TextBlock x:Name="Queue" Text="—" FontSize="28" Margin="0,3,0,0"/><TextBlock x:Name="QueueDetail" Text="คำขอที่รอ worker" Foreground="#737E89" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="Workers และ Sessions" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SessionCount" Text="—" HorizontalAlignment="Right" Foreground="#8BAABD"/></Grid>
   <Grid Grid.Row="3" MinHeight="150">
    <Border x:Name="SessionsFrame" Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12">
     <Grid>
      <DataGrid x:Name="Sessions"><DataGrid.Columns>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Workspace" Binding="{Binding Workspace}" Width="*" MinWidth="140"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Session" Binding="{Binding Session}" Width="105"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="สถานะ" Binding="{Binding State}" Width="105"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PID" Binding="{Binding Pid}" Width="72"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="คำขอ" Binding="{Binding InFlight}" Width="60"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="คิว" Binding="{Binding Queue}" Width="55"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ล่าสุด" Binding="{Binding LastActive}" Width="85"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock x:Name="Empty" Text="ยังไม่มี session · เรียกเครื่องมือจากแชทเพื่อเริ่มงาน" Foreground="#89949E" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="4" Margin="0,18,0,10"><TextBlock Text="Agents และ Tasks" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="AgentTaskCount" Text="—" HorizontalAlignment="Right" Foreground="#8BAABD" FontSize="11" VerticalAlignment="Center"/></Grid>
   <Grid Grid.Row="5" Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="AgentsFrame" Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12" Margin="0,0,6,0">
     <DataGrid x:Name="Agents"><DataGrid.Columns>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Agent" Binding="{Binding Name}" Width="*" MinWidth="110"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Role" Binding="{Binding Role}" Width="90"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="สถานะ" Binding="{Binding Status}" Width="80"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="งาน" Binding="{Binding TaskCount}" Width="55"/>
     </DataGrid.Columns></DataGrid>
    </Border>
    <Border x:Name="TasksFrame" Grid.Column="1" Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12" Margin="6,0,0,0">
     <DataGrid x:Name="Tasks"><DataGrid.Columns>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Task" Binding="{Binding Title}" Width="*" MinWidth="130"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="สถานะ" Binding="{Binding Status}" Width="80"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Agent" Binding="{Binding Agent}" Width="90"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Priority" Binding="{Binding Priority}" Width="60"/>
     </DataGrid.Columns></DataGrid>
    </Border>
   </Grid>
   <Grid Grid.Row="6" Margin="0,8,0,10"><TextBlock Text="เหตุการณ์ล่าสุด" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="เลือกแถวเพื่อดูรายละเอียดด้านล่าง" HorizontalAlignment="Right" Foreground="#8BAABD" FontSize="11" VerticalAlignment="Center"/></Grid>
   <Border x:Name="EventsFrame" Grid.Row="7" Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12">
    <DataGrid x:Name="Events"><DataGrid.Columns>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="เวลา" Binding="{Binding Time}" Width="85"/>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ผล" Binding="{Binding Status}" Width="65"/>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="เหตุการณ์ / เครื่องมือ" Binding="{Binding Event}" Width="*"/>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="รายละเอียด" Binding="{Binding Detail}" Width="2*"/>
    </DataGrid.Columns></DataGrid>
   </Border>
   <StackPanel Grid.Row="8" Margin="0,12,0,0"><TextBox x:Name="Detail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Text="เลือก session เพื่อดูโฟลเดอร์เต็ม หรือเลือกเหตุการณ์เพื่อดูข้อผิดพลาด" FontSize="12" Foreground="#9AB9CA" MaxHeight="60"/><TextBlock x:Name="ActionStatus" Text="Dashboard อ่านสถานะโดยไม่เปิด worker เพิ่ม · Stop หยุด tunnel ส่วนงานใน broker อาจยังทำงานต่อ" FontSize="11" Foreground="#6F96AC" Margin="0,8,0,0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
