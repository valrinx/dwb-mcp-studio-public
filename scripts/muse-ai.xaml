<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="N3zuui · Muse AI" Width="1160" Height="800" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
 Foreground="#EAFBFF" FontFamily="Leelawadee UI, Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Window.Background><RadialGradientBrush Center="0.76,1" GradientOrigin="0.76,1" RadiusX="1.2" RadiusY="1.05"><GradientStop Color="#171A20" Offset="0"/><GradientStop Color="#0D0F13" Offset="0.48"/><GradientStop Color="#08090C" Offset="1"/></RadialGradientBrush></Window.Background>
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#A9F5FF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#EAFBFF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#8D98A3"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2A3038"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#111419"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#111419"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#2A3038"/>
   <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform x:Name="Scale"/></Border.RenderTransform>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.14"/>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.14"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
       <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Grid Grid.Row="0" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="N3ZUUI  /  REMOTE BRIDGE" Foreground="#A9F5FF" FontSize="10" FontWeight="Bold"/>
     <TextBlock x:Name="BrandTitle" Text="Muse AI" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
     <TextBlock Text="เชื่อมต่อ Muse กับ Studio ของคุณผ่าน stdio-to-HTTP bridge · ไม่ต้องเปิดพอร์ตเพิ่ม" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <Button x:Name="Refresh" Grid.Column="1" Content="⟳  รีเฟรชสถานะ" VerticalAlignment="Center" Padding="16,11"/>
   </Grid>

   <Border x:Name="BridgeStatusCard" Grid.Row="1" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,15">
    <Border.Background><RadialGradientBrush Center="0.78,1" GradientOrigin="0.78,1" RadiusX="1.2" RadiusY="1"><GradientStop Color="#1B2529" Offset="0"/><GradientStop Color="#111419" Offset="0.58"/><GradientStop Color="#0D0F13" Offset="1"/></RadialGradientBrush></Border.Background>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse x:Name="BridgeDot" Width="9" Height="9" Fill="#91A8BF" VerticalAlignment="Center" Margin="0,0,9,0"/>
       <TextBlock x:Name="BridgeStateLabel" Text="กำลังตรวจสอบ…" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="8" Padding="11,7" HorizontalAlignment="Right" VerticalAlignment="Center">
       <TextBlock x:Name="BridgeEndpoint" Text="http://127.0.0.1:3000/mcp" Foreground="#A9F5FF" FontSize="12" FontFamily="Consolas, Segoe UI"/>
      </Border>
     </Grid>
     <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0">
       <TextBlock Text="TUNNEL URL · สาธารณะ" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,6"/>
       <Border Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="8" Padding="11,8">
        <TextBlock x:Name="TunnelUrl" Text="ยังไม่ได้เปิด tunnel" Foreground="#DDE7EB" FontSize="12" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis"/>
       </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
       <TextBlock Text="BEARER TOKEN" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,6"/>
       <Border Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="8" Padding="11,8">
        <TextBlock x:Name="TokenState" Text="กำลังอ่าน…" Foreground="#DDE7EB" FontSize="12" FontFamily="Consolas, Segoe UI"/>
       </Border>
      </StackPanel>
     </Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
      <Button x:Name="StartBridge" Content="เริ่ม Bridge" Padding="16,10"/>
      <Button x:Name="StartTunnel" Content="เริ่ม Tunnel" Margin="10,0,0,0" Padding="16,10"/>
      <Button x:Name="CopyForMuse" Content="คัดลอกข้อความสำหรับ Muse  →" Background="#A9F5FF" Foreground="#071014" BorderBrush="#A9F5FF" FontWeight="Bold" Margin="10,0,0,0" Padding="16,10"/>
     </StackPanel>
    </Grid>
   </Border>

   <Border x:Name="FlowCard" Grid.Row="2" Background="#0F151D" BorderBrush="#34445A" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,15">
    <StackPanel>
     <TextBlock Text="เส้นทางการเชื่อมต่อ" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="Muse ในแชทใหม่คุยกับ Studio ของคุณผ่าน tunnel สาธารณะ — ไม่ต้องตั้งค่าเครือข่ายเพิ่ม" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
     <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="10" Padding="12,10">
       <StackPanel><TextBlock Text="Muse" Foreground="#A9F5FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="แชทใหม่ วางข้อความเชื่อมต่อ" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <TextBlock Grid.Column="1" Text="→" Foreground="#A9F5FF" FontSize="20" VerticalAlignment="Center" Margin="8,0"/>
      <Border Grid.Column="2" Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="10" Padding="12,10">
       <StackPanel><TextBlock Text="Tunnel URL" Foreground="#A9F5FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="https://…trycloudflare.com" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <TextBlock Grid.Column="3" Text="→" Foreground="#A9F5FF" FontSize="20" VerticalAlignment="Center" Margin="8,0"/>
      <Border Grid.Column="4" Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="10" Padding="12,10">
       <StackPanel><TextBlock Text="Bridge" Foreground="#A9F5FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="127.0.0.1:3000/mcp" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <TextBlock Grid.Column="5" Text="→" Foreground="#A9F5FF" FontSize="20" VerticalAlignment="Center" Margin="8,0"/>
      <Border Grid.Column="6" Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="10" Padding="12,10">
       <StackPanel><TextBlock Text="Studio" Foreground="#A9F5FF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="stdio MCP · tools ทั้งหมด" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
      </Border>
     </Grid>
     <TextBlock Text="Tunnel URL เปลี่ยนทุกครั้งที่รีสตาร์ท — คัดลอกข้อความใหม่ทุกครั้งก่อนเริ่มแชทกับ Muse" Foreground="#8FA9B8" FontSize="10" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>

   <Border x:Name="SetupCard" Grid.Row="3" Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,15">
    <StackPanel>
     <TextBlock Text="ขั้นตอนการตั้งค่า" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="22" Height="22" Background="#A9F5FF" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="1" Foreground="#071014" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Grid.Column="1" Text="รัน npm run bridge บนเครื่องนี้ — เปิด HTTP endpoint ที่ http://127.0.0.1:3000/mcp" Foreground="#DDE7EB" VerticalAlignment="Center"/>
     </Grid>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="22" Height="22" Background="#A9F5FF" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="2" Foreground="#071014" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Grid.Column="1" Text="กด “เริ่ม Tunnel” ด้านบน (หรือรัน npm run tunnel) — จะได้ URL สาธารณะ https://…trycloudflare.com" Foreground="#DDE7EB" VerticalAlignment="Center"/>
     </Grid>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="22" Height="22" Background="#A9F5FF" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="3" Foreground="#071014" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Grid.Column="1" Text="กด “คัดลอกข้อความสำหรับ Muse” แล้ววางในแชทใหม่กับ Muse" Foreground="#DDE7EB" VerticalAlignment="Center"/>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="22" Height="22" Background="#A9F5FF" CornerRadius="11" VerticalAlignment="Top"><TextBlock Text="4" Foreground="#071014" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Grid.Column="1" Text="Muse จะเชื่อมต่อผ่าน bridge และเรียก tools ของ Studio ได้ทันที" Foreground="#DDE7EB" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel>
   </Border>

   <Border x:Name="SecurityCard" Grid.Row="4" Background="#171208" BorderBrush="#6B4E1F" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,15">
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="⚠" Foreground="#F0A13C" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="ข้อควรระวัง" FontSize="15" FontWeight="SemiBold" Foreground="#F5D9A8" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock Text="• Token กับ Tunnel URL คือกุญแจ — ใครมีครบทั้งคู่เรียก tools บนเครื่องนี้ได้ อย่าแชร์ในที่สาธารณะ" Foreground="#D8C49A" FontSize="11" Margin="0,0,0,6"/>
     <TextBlock Text="• Bridge ฟังเฉพาะ 127.0.0.1 — ไม่ได้เปิดพอร์ตออกอินเทอร์เน็ตโดยตรง" Foreground="#D8C49A" FontSize="11" Margin="0,0,0,6"/>
     <TextBlock Text="• Tunnel URL เปลี่ยนทุกครั้งที่รีสตาร์ท — เลิกใช้แล้วให้ปิดหน้าต่าง tunnel" Foreground="#D8C49A" FontSize="11"/>
    </StackPanel>
   </Border>

   <Border x:Name="FooterPanel" Grid.Row="5" Background="#0D0F13" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="10" Padding="12,9">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="✦" Foreground="#A9F5FF" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <StackPanel Grid.Column="1"><TextBlock x:Name="ActionStatus" Text="พร้อม — กดรีเฟรชเพื่อตรวจสอบสถานะ bridge" Foreground="#C8D7E5" FontSize="11"/><TextBlock Text="Bridge config อยู่ที่ bridge.config.json (gitignore แล้ว) · URL ของ tunnel เปลี่ยนทุกครั้งที่รีสตาร์ท" Foreground="#8197AB" FontSize="10" Margin="0,4,0,0"/></StackPanel>
    </Grid>
   </Border>

  </Grid>
 </ScrollViewer>
</Window>
